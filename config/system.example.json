  "workflows": [
    {
      "id": "workflow-deploy-app",
      "name": "Deploy Application",
      "description": "Multi-step workflow to build and deploy the application",
      "enabled": true,
      "steps": [
        {
          "id": "step-1",
          "name": "Run tests",
          "action": {"ShellCommand": "cd ~/projects/myapp && npm test"},
          "continue_on_error": false,
          "timeout_ms": 60000
        },
        {
          "id": "step-2",
          "name": "Build application",
          "action": {"ShellCommand": "cd ~/projects/myapp && npm run build"},
          "continue_on_error": false,
          "timeout_ms": 120000
        },
        {
          "id": "step-3",
          "name": "Deploy to server",
          "action": {"ShellCommand": "cd ~/projects/myapp && npm run deploy"},
          "continue_on_error": false,
          "timeout_ms": 180000
        },
        {
          "id": "step-4",
          "name": "Notify completion",
          "action": {"ShellCommand": "notify-send 'Deployment Complete' 'Application has been deployed successfully'"},
          "continue_on_error": true,
          "timeout_ms": 5000
        }
      ],
      "variables": {
        "APP_ENV": "production",
        "DEPLOY_TARGET": "server1"
      },
      "on_error": "abort",
      "metadata": {
        "created_at": "2024-01-01T00:00:00Z",
        "updated_at": "2024-01-01T00:00:00Z",
        "last_run": null,
        "run_count": 0,
        "tags": ["deployment", "ci-cd"]
      }
    },
