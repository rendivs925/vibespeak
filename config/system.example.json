  "scripts": [
    {
      "id": "script-backup",
      "name": "Backup Home Directory",
      "description": "Creates a compressed backup of important directories",
      "language": "bash",
      "content": "#!/bin/bash\nset -e\n\nBACKUP_DIR=\"/backup\"\nDATE=$(date +%Y-%m-%d_%H%M%S)\nSOURCE_DIRS=\"$HOME/Documents $HOME/Projects $HOME/.config\"\n\necho \"Starting backup...\"\nmkdir -p \"$BACKUP_DIR\"\n\nfor dir in $SOURCE_DIRS; do\n    if [ -d \"$dir\" ]; then\n        echo \"Backing up $dir...\"\n        tar -czf \"$BACKUP_DIR/$(basename $dir)_$DATE.tar.gz\" -C \"$(dirname $dir)\" \"$(basename $dir)\"\n    fi\ndone\n\necho \"Backup completed successfully!\"",
      "enabled": true,
      "timeout_ms": 600000,
      "metadata": {
        "created_at": "2024-01-01T00:00:00Z",
        "updated_at": "2024-01-01T00:00:00Z",
        "last_run": null,
        "run_count": 0,
        "tags": ["backup", "system"]
      }
    },
    {
      "id": "script-cleanup",
      "name": "System Cleanup",
      "description": "Cleans temporary files and cache",
      "language": "bash",
      "content": "#!/bin/bash\nset -e\n\necho \"Cleaning temporary files...\"\nrm -rf /tmp/*\nrm -rf ~/.cache/thumbnails/*\n\necho \"Cleaning package cache...\"\nsudo pacman -Sc --noconfirm 2>/dev/null || apt-get clean 2>/dev/null || true\n\necho \"Cleanup completed!\"",
      "enabled": true,
      "timeout_ms": 120000,
      "metadata": {
        "created_at": "2024-01-01T00:00:00Z",
        "updated_at": "2024-01-01T00:00:00Z",
        "last_run": null,
        "run_count": 0,
        "tags": ["cleanup", "maintenance"]
      }
    },
    {
      "id": "script-system-info",
      "name": "System Information",
      "description": "Displays system information",
      "language": "python",
      "content": "#!/usr/bin/env python3\nimport platform\nimport psutil\nimport os\n\nprint(\"=\" * 50)\nprint(\"SYSTEM INFORMATION\")\nprint(\"=\" * 50)\nprint(f\"OS: {platform.system()} {platform.release()}\")\nprint(f\"Architecture: {platform.machine()}\")\nprint(f\"Hostname: {platform.node()}\")\nprint(f\"Python: {platform.python_version()}\")\nprint()\nprint(\"CPU:\")\nprint(f\"  Cores: {psutil.cpu_count(logical=False)} physical, {psutil.cpu_count()} logical\")\nprint(f\"  Usage: {psutil.cpu_percent()}%\")\nprint()\nmem = psutil.virtual_memory()\nprint(\"Memory:\")\nprint(f\"  Total: {mem.total / (1024**3):.1f} GB\")\nprint(f\"  Used: {mem.used / (1024**3):.1f} GB ({mem.percent}%)\")\nprint(f\"  Free: {mem.available / (1024**3):.1f} GB\")\nprint()\ndisk = psutil.disk_usage('/')\nprint(\"Disk (/):\")\nprint(f\"  Total: {disk.total / (1024**3):.1f} GB\")\nprint(f\"  Used: {disk.used / (1024**3):.1f} GB ({disk.percent}%)\")\nprint(f\"  Free: {disk.free / (1024**3):.1f} GB\")\nprint(\"=\" * 50)",
      "enabled": true,
      "timeout_ms": 30000,
      "metadata": {
        "created_at": "2024-01-01T00:00:00Z",
        "updated_at": "2024-01-01T00:00:00Z",
        "last_run": null,
        "run_count": 0,
        "tags": ["system", "info", "python"]
      }
    }
  ],
